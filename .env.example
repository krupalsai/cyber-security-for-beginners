# Copy to .env (or set these as environment variables on your hosting service)

# Protects the site so strangers can't spend your API credits. STRONGLY recommended when online.
APP_PASSWORD=change-me

# https://account.shodan.io  -> "API Key"
SHODAN_API_KEY=

# Qwen via Alibaba Cloud Model Studio (DashScope), OpenAI-compatible API
# Key: https://modelstudio.console.alibabacloud.com  -> API Keys
QWEN_API_KEY=
# Any model ID your account has, e.g. qwen-plus, qwen-max, or a newer Qwen3.x model ID
QWEN_MODEL=qwen-plus
# International endpoint (default). Mainland China: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# A running SpiderFoot web UI, e.g. started with:  python3 sf.py -l 0.0.0.0:5001
SPIDERFOOT_URL=
# Only if you enabled SpiderFoot's passwd file (HTTP auth)
SPIDERFOOT_USER=
SPIDERFOOT_PASS=

PORT=3000
